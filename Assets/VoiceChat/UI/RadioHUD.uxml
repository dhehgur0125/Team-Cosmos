<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <ui:Style src="RadioHUD.uss" />
    <ui:VisualElement name="Root" class="root" picking-mode="Ignore">
        <ui:VisualElement name="Card" class="card">

            <ui:VisualElement class="header">
                <ui:VisualElement name="StatusDot" class="status-dot dot-connecting" />
                <ui:Label name="TitleLabel" text="VOICE CHAT" class="title" />
                <ui:VisualElement class="spacer" />
                <ui:Label name="MemberLabel" text="접속 0명" class="chip" />
            </ui:VisualElement>

            <ui:Label name="StatusLabel" text="서버 연결 중..." class="mode-label mode-connecting" />
            <ui:Label name="SubLabel" text="Unity Services · Vivox 로그인 중" class="sub-label" />

            <ui:VisualElement class="meter-row">
                <ui:Label text="MIC" class="meter-caption" />
                <ui:VisualElement name="MicMeter" class="meter" />
            </ui:VisualElement>

            <ui:VisualElement class="divider" />

            <ui:VisualElement class="hint-row">
                <ui:VisualElement class="hint">
                    <ui:Label text="V" class="keycap" />
                    <ui:Label text="무전기 (누르는 동안)" class="hint-text" />
                </ui:VisualElement>
                <ui:VisualElement class="hint">
                    <ui:Label text="T" class="keycap" />
                    <ui:Label text="소리 내기" class="hint-text" />
                </ui:VisualElement>
            </ui:VisualElement>

        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
