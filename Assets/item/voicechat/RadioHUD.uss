/* ===== Voice Chat HUD ===== */

.root {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    flex-direction: column;
    justify-content: flex-end;
    align-items: flex-start;
    padding: 28px;
}

.card {
    width: 380px;
    padding: 16px 20px 14px 20px;
    background-color: rgba(16, 18, 26, 0.84);
    border-radius: 18px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.10);
}

/* --- 헤더 --- */
.header {
    flex-direction: row;
    align-items: center;
    margin-bottom: 10px;
}

.status-dot {
    width: 10px;
    height: 10px;
    border-radius: 5px;
    margin-right: 8px;
    background-color: rgb(250, 204, 21);
    transition-property: background-color;
    transition-duration: 0.25s;
}

.dot-connecting { background-color: rgb(250, 204, 21); }
.dot-ok         { background-color: rgb(52, 211, 153); }
.dot-radio      { background-color: rgb(248, 113, 113); }
.dot-error      { background-color: rgb(239, 68, 68); }

.title {
    font-size: 12px;
    -unity-font-style: bold;
    letter-spacing: 2px;
    color: rgba(255, 255, 255, 0.55);
}

.spacer {
    flex-grow: 1;
}

.chip {
    font-size: 12px;
    color: rgba(255, 255, 255, 0.85);
    background-color: rgba(255, 255, 255, 0.09);
    border-radius: 10px;
    padding: 2px 10px;
}

/* --- 상태 텍스트 --- */
.mode-label {
    font-size: 26px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    margin-bottom: 2px;
    transition-property: color;
    transition-duration: 0.2s;
}

.mode-connecting { color: rgb(253, 224, 71); }
.mode-proximity  { color: rgb(110, 231, 183); }
.mode-radio      { color: rgb(252, 165, 165); }
.mode-error      { color: rgb(252, 165, 165); }

.sub-label {
    font-size: 12px;
    color: rgba(255, 255, 255, 0.50);
    white-space: normal;
    margin-bottom: 14px;
}

/* --- 마이크 레벨 미터 --- */
.meter-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 14px;
}

.meter-caption {
    width: 38px;
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    color: rgba(255, 255, 255, 0.50);
}

.meter {
    flex-direction: row;
    flex-grow: 1;
    height: 12px;
}

.meter-seg {
    flex-grow: 1;
    height: 12px;
    margin-right: 3px;
    border-radius: 3px;
    background-color: rgba(255, 255, 255, 0.10);
}

.meter-seg-low  { background-color: rgb(52, 211, 153); }
.meter-seg-mid  { background-color: rgb(250, 204, 21); }
.meter-seg-high { background-color: rgb(248, 113, 113); }

/* --- 키 안내 --- */
.divider {
    height: 1px;
    background-color: rgba(255, 255, 255, 0.08);
    margin-bottom: 12px;
}

.hint-row {
    flex-direction: row;
    flex-wrap: wrap;
}

.hint {
    flex-direction: row;
    align-items: center;
    margin-right: 16px;
}

.keycap {
    min-width: 24px;
    height: 24px;
    padding-left: 6px;
    padding-right: 6px;
    margin-right: 7px;
    -unity-text-align: middle-center;
    font-size: 12px;
    -unity-font-style: bold;
    color: rgb(255, 255, 255);
    background-color: rgba(255, 255, 255, 0.12);
    border-radius: 6px;
    border-width: 1px;
    border-bottom-width: 2px;
    border-color: rgba(255, 255, 255, 0.22);
}

.hint-text {
    font-size: 12px;
    color: rgba(255, 255, 255, 0.62);
}
